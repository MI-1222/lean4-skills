import Lean

/-!
# `#long_decls`

Reports declarations whose source spans more than a given number of lines.

A theorem of thousands of lines is one command for Lean: it has one heartbeat budget, it is
elaborated as one task, and an error anywhere in it is reported against the whole proof. The
command reads the source range that Lean stores for each declaration, so it also works for
declarations imported from compiled modules, and it lists the long ones, longest first.

Usage, from the project root (prepend the imports that bring the declarations into scope):

```bash
{ echo "import MyProject.Main"; cat long_decls.lean; echo "#long_decls 200 MyProject"; } \
  | lake env lean --stdin
```

`#long_decls 200 A B.c` checks every declaration whose name starts with `A` or `B.c`, compared by
name component, and reports those longer than 200 lines. Private declarations are included under
their user-facing names. Each long declaration is a warning, and a final info message gives the
totals and the longest declaration. To make the check fail in CI, run the command under
`set_option warningAsError true in`, so that each warning becomes an error and `lean` exits with
code 1.

Limits:
- The length is counted from the first to the last line of the declaration, including its
  docstring and attributes, blank lines and comments inside it.
- Declarations without a stored range, such as those generated by Lean or created by
  metaprograms, are skipped.
-/

open Lean Meta Elab Command

namespace LongDecls

/-- Returns true for declarations that Lean generates rather than the user writes. -/
def isGenerated (env : Environment) (name userName : Name) : Bool :=
  userName.isInternalDetail || isAuxRecursor env name || isNoConfusion env name ||
    isMatcherCore env name

/-- Returns the module that declares `name`, or the current module. -/
def moduleOf (env : Environment) (name : Name) : Name :=
  match env.getModuleIdxFor? name with
  | some idx => env.header.moduleNames[idx.toNat]!
  | none => env.mainModule

/-- `#long_decls N P₁ P₂ ...` reports declarations with one of the given prefixes that span more
than `N` lines. -/
syntax (name := longDeclsCmd) "#long_decls " num (ppSpace ident)+ : command

@[command_elab longDeclsCmd]
def elabLongDecls : CommandElab := fun stx => do
  let limit := stx[1].toNat
  let prefixes := stx[2].getArgs.map (·.getId)
  let env ← getEnv
  let mut checked : Nat := 0
  -- `(lines, user-facing name, module, first line)` of every declaration over the limit.
  let mut long : Array (Nat × Name × Name × Nat) := #[]
  let mut longest : Option (Nat × Name) := none
  for (name, _) in env.constants.toList do
    let userName := privateToUserName name
    unless prefixes.any (·.isPrefixOf userName) do continue
    if isGenerated env name userName then continue
    let some ranges ← findDeclarationRanges? name | continue
    checked := checked + 1
    let lines := ranges.range.endPos.line - ranges.range.pos.line + 1
    if longest.all (·.1 < lines) then longest := some (lines, userName)
    if lines > limit then
      long := long.push (lines, userName, moduleOf env name, ranges.range.pos.line)
  long := long.qsort fun a b => a.1 > b.1 || (a.1 == b.1 && a.2.1.lt b.2.1)
  for (lines, userName, module, line) in long do
    logWarning m!"`{userName}` ({module}, line {line}) spans {lines} lines, over the limit of {limit}"
  let longestText := match longest with
    | some (lines, userName) => s!", longest `{userName}` with {lines} lines"
    | none => ""
  logInfo m!"#long_decls: {checked} declaration(s) checked, {long.size} over {limit} lines\
    {longestText}"

end LongDecls
