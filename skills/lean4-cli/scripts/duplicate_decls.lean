import Lean

/-!
# `#duplicate_decls`

Reports theorems that state the same proposition and definitions that are the same term under
different names.

Copying a file or retrying a lemma under a new name (`foo_alt`, `foo_bis`) leaves declarations that
say the same thing. Each copy costs build time and review time, and later fixes reach only one of
them. The command compares the elaborated declarations, not the source text, so it also finds
copies whose proofs, binder names, `open` commands or layout differ:

- Two theorems are duplicates when their statements are the same expression up to the names of
  bound variables. Their proofs are not compared, since either proof proves both.
- Two definitions are duplicates when their types and their values are both the same expression
  up to the names of bound variables.

Binder annotations are ignored, so `{n : ℕ}` and `(n : ℕ)` count as the same binder. Universe
parameters are compared by position.

Usage, from the project root (prepend the imports that bring the declarations into scope):

```bash
{ echo "import MyProject.Main"; cat duplicate_decls.lean; echo "#duplicate_decls MyProject"; } \
  | lake env lean --stdin
```

`#duplicate_decls A B.c` checks every theorem and definition whose name starts with `A` or `B.c`,
compared by name component. Private declarations are included under their user-facing names.
Each group of duplicates is a warning that lists the names and modules, and a final info message
gives the totals.

Limits:
- Statements that are equal only after unfolding a definition (`X.Statement` against its body) are
  not reported.
- A definition whose value refers to its own auxiliary declarations (`foo.match_1`, `foo.proof_1`)
  does not match a copy that refers to `bar.match_1`. Lean shares identical matchers within one
  module, so copies by pattern matching are found inside a module but missed across modules.
- Auxiliary declarations generated by Lean (equation lemmas, matchers, recursors) are skipped.
-/

open Lean Meta Elab Command

namespace DuplicateDecls

/-- What a declaration is compared by: the kind, the statement or type, and the value of a
definition. Universe parameters are renamed by position so that their names do not matter. -/
structure Key where
  isTheorem : Bool
  type : Expr
  value : Option Expr
  deriving BEq, Hashable

/-- Replaces universe parameters by `u_1`, `u_2`, ... in order of declaration. -/
def positionalLevels (levelParams : List Name) (e : Expr) : Expr :=
  let positional := (List.range levelParams.length).map fun i => Level.param (.mkSimple s!"u_{i + 1}")
  e.instantiateLevelParams levelParams positional

/-- Returns the comparison key of a theorem or definition, or `none` for other constants. -/
def keyOf : ConstantInfo → Option Key
  | .thmInfo val =>
    some { isTheorem := true, type := positionalLevels val.levelParams val.type, value := none }
  | .defnInfo val =>
    some {
      isTheorem := false
      type := positionalLevels val.levelParams val.type
      value := some (positionalLevels val.levelParams val.value) }
  | _ => none

/-- Returns true for declarations that Lean generates rather than the user writes. -/
def isGenerated (env : Environment) (name userName : Name) : Bool :=
  userName.isInternalDetail || isAuxRecursor env name || isNoConfusion env name ||
    isMatcherCore env name

/-- Returns the module that declares `name`, or the current module. -/
def moduleOf (env : Environment) (name : Name) : Name :=
  match env.getModuleIdxFor? name with
  | some idx => env.header.moduleNames[idx.toNat]!
  | none => env.mainModule

/-- `#duplicate_decls P₁ P₂ ...` checks every theorem and definition whose name has one of the
given prefixes. -/
syntax (name := duplicateDeclsCmd) "#duplicate_decls" (ppSpace ident)+ : command

/-- The number of names printed per group before the rest are summarized. -/
def maxNamesShown : Nat := 10

@[command_elab duplicateDeclsCmd]
def elabDuplicateDecls : CommandElab := fun stx => do
  let prefixes := stx[1].getArgs.map (·.getId)
  let env ← getEnv
  let mut groups : Std.HashMap Key (Array Name) := {}
  let mut checked : Nat := 0
  for (name, info) in env.constants.toList do
    let userName := privateToUserName name
    unless prefixes.any (·.isPrefixOf userName) do continue
    if isGenerated env name userName then continue
    let some key := keyOf info | continue
    checked := checked + 1
    groups := groups.insert key ((groups.getD key #[]).push name)
  let duplicates := groups.toArray.filterMap fun (key, names) =>
    if names.size < 2 then none
    else some (key.isTheorem, names.qsort fun a b => (privateToUserName a).lt (privateToUserName b))
  let duplicates := duplicates.qsort fun a b => (privateToUserName a.2[0]!).lt (privateToUserName b.2[0]!)
  let mut copies : Nat := 0
  for (isTheorem, names) in duplicates do
    copies := copies + (names.size - 1)
    let shown := names.extract 0 maxNamesShown |>.toList.map fun name =>
      s!"`{privateToUserName name}` ({moduleOf env name})"
    let rest := if names.size > maxNamesShown then s!", and {names.size - maxNamesShown} more" else ""
    let what := if isTheorem then "state the same proposition" else "are the same definition"
    logWarning m!"{names.size} declarations {what}: {", ".intercalate shown}{rest}"
  logInfo m!"#duplicate_decls: {checked} declaration(s) checked, {duplicates.size} duplicate \
    group(s), {copies} redundant cop{if copies == 1 then "y" else "ies"}"

end DuplicateDecls
